# Copy to .env and set only the providers you use. Never submit a populated .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

CADENGBENCH_PROVIDER=openai
CADENGBENCH_MODEL=gpt-5.2-2025-12-11
CADENGBENCH_RUN_ID=reviewer-sample
CADENGBENCH_WORKERS=2
# Optional override. Setup otherwise discovers the bundled local solver environment.
CADENGBENCH_CCX=
