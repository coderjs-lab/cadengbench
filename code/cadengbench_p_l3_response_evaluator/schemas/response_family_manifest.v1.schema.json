{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/l3-response-family-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_sha256", "item_id", "contract_path", "contract_sha256", "card_path", "card_sha256", "variants"],
  "properties": {
    "schema_version": {"const": "cadengbench-p.l3-response-family-manifest.v1"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item_id": {"type": "string"},
    "contract_path": {"type": "string"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "card_path": {"type": "string"},
    "card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["variant_id", "upstream_status", "reference_step_path", "reference_step_sha256", "candidate_step_path", "candidate_step_sha256"],
        "properties": {
          "variant_id": {"type": "string", "minLength": 1},
          "upstream_status": {"type": "string"},
          "reference_step_path": {"type": "string"},
          "reference_step_sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "candidate_step_path": {"type": "string"},
          "candidate_step_sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}
        }
      }
    }
  }
}
