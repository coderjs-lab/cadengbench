{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_annotation_attempt_v2.schema.json",
  "title": "CADEngBench-P v2 strict annotation attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "attempt_id", "item_id", "role_id", "provider", "model", "decoder", "seed", "token_limit", "timestamps", "environment", "retrieval", "prompt", "input", "request", "response", "output", "usage", "exit", "tool_calls", "provenance"],
  "properties": {
    "schema_version": {"const": "cadengbench-p.annotation-attempt.v2"},
    "record_type": {"const": "strict_annotation_attempt"},
    "attempt_id": {"$ref": "#/$defs/nonEmpty"}, "item_id": {"$ref": "#/$defs/nonEmpty"}, "role_id": {"$ref": "#/$defs/nonEmpty"},
    "provider": {"type": "object", "additionalProperties": false, "required": ["name", "api_revision"], "properties": {"name": {"$ref": "#/$defs/nonEmpty"}, "api_revision": {"$ref": "#/$defs/nonEmpty"}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["id", "revision"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "revision": {"$ref": "#/$defs/nonEmpty"}}},
    "decoder": {"type": "object", "additionalProperties": false, "required": ["max_output_tokens", "temperature", "top_p", "response_format", "stop"], "properties": {"max_output_tokens": {"type": "integer", "minimum": 1}, "temperature": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "top_p": {"anyOf": [{"type": "number", "exclusiveMinimum": 0, "maximum": 1}, {"type": "null"}]}, "response_format": {"enum": ["json", "json_schema", "text"]}, "stop": {"type": "array", "items": {"type": "string"}}}},
    "seed": {"$ref": "#/$defs/seed"}, "token_limit": {"$ref": "#/$defs/tokenLimit"}, "timestamps": {"$ref": "#/$defs/timestamps"}, "environment": {"$ref": "#/$defs/environment"}, "retrieval": {"$ref": "#/$defs/retrieval"},
    "prompt": {"$ref": "#/$defs/digest"}, "input": {"$ref": "#/$defs/digest"}, "request": {"$ref": "#/$defs/digest"}, "response": {"$ref": "#/$defs/digest"}, "output": {"$ref": "#/$defs/payload"},
    "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": {"input_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "output_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "total_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "status": {"enum": ["recorded", "not_exposed"]}}},
    "exit": {"$ref": "#/$defs/exit"}, "tool_calls": {"type": "array", "items": {"$ref": "#/$defs/toolCall"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["parent_run_id", "attempt_sequence", "input_item_sha256"], "properties": {"parent_run_id": {"$ref": "#/$defs/nonEmpty"}, "attempt_sequence": {"type": "integer", "minimum": 1}, "input_item_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "imported_legacy": {"const": false}}},
    "observability": {"type": "object", "additionalProperties": false, "required": ["usage", "tool_calls", "exact_model_revision", "decoder_parameters"], "properties": {"usage": {"enum": ["recorded", "not_exposed"]}, "tool_calls": {"enum": ["recorded", "not_exposed"]}, "exact_model_revision": {"enum": ["recorded", "not_exposed"]}, "decoder_parameters": {"enum": ["recorded", "partially_exposed", "not_exposed"]}}}
  },
  "allOf": [{"if": {"properties": {"decoder": {"properties": {"max_output_tokens": {"type": "integer"}}}, "token_limit": {"properties": {"requested": {"type": "integer"}}}}}, "then": {"properties": {"token_limit": {"properties": {"requested": {"minimum": 1}}}}}}, {"if": {"properties": {"usage": {"required": ["input_tokens", "output_tokens", "total_tokens"]}}}, "then": {"properties": {"usage": {"properties": {"total_tokens": {"minimum": 0}}}}}}],
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "digest": {"type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}, "content_type": {"type": "string", "minLength": 1}}},
    "seed": {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"enum": ["set", "not_supported"]}, "value": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"status": {"const": "set"}}}, "then": {"properties": {"value": {"type": "integer", "minimum": 0}}}}, {"if": {"properties": {"status": {"const": "not_supported"}}}, "then": {"properties": {"value": {"type": "null"}}}}]},
    "tokenLimit": {"type": "object", "additionalProperties": false, "required": ["requested", "enforced"], "properties": {"requested": {"type": "integer", "minimum": 1}, "enforced": {"type": "boolean"}}},
    "timestamps": {"type": "object", "additionalProperties": false, "required": ["submitted_at", "started_at", "completed_at"], "properties": {"submitted_at": {"type": "string", "format": "date-time"}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["digest", "runtime", "host_class"], "properties": {"digest": {"$ref": "#/$defs/sha256"}, "runtime": {"$ref": "#/$defs/nonEmpty"}, "host_class": {"$ref": "#/$defs/nonEmpty"}}},
    "retrieval": {"type": "object", "additionalProperties": false, "required": ["used", "snapshot_sha256", "sources"], "properties": {"used": {"type": "boolean"}, "snapshot_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "sources": {"type": "array", "items": {"$ref": "#/$defs/digest"}}}, "allOf": [{"if": {"properties": {"used": {"const": true}}}, "then": {"properties": {"snapshot_sha256": {"$ref": "#/$defs/sha256"}}}}, {"if": {"properties": {"used": {"const": false}}}, "then": {"properties": {"snapshot_sha256": {"type": "null"}, "sources": {"maxItems": 0}}}}]},
    "payload": {"type": "object", "additionalProperties": false, "required": ["digest", "status"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["complete", "partial", "empty", "unavailable"]}, "content_type": {"type": "string", "minLength": 1}}},
    "exit": {"type": "object", "additionalProperties": false, "required": ["status", "code", "error_type"], "properties": {"status": {"enum": ["completed", "failed", "terminated"]}, "code": {"type": "integer", "minimum": 0}, "error_type": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"status": {"const": "completed"}}}, "then": {"properties": {"code": {"const": 0}, "error_type": {"type": "null"}}}}, {"if": {"properties": {"status": {"enum": ["failed", "terminated"]}}}, "then": {"properties": {"error_type": {"type": "string", "minLength": 1}}}}]},
    "toolCall": {"type": "object", "additionalProperties": false, "required": ["call_id", "tool_name", "request", "response", "started_at", "completed_at", "exit"], "properties": {"call_id": {"$ref": "#/$defs/nonEmpty"}, "tool_name": {"$ref": "#/$defs/nonEmpty"}, "request": {"$ref": "#/$defs/digest"}, "response": {"$ref": "#/$defs/digest"}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "exit": {"type": "object", "additionalProperties": false, "required": ["status", "code"], "properties": {"status": {"enum": ["completed", "failed", "terminated"]}, "code": {"type": "integer", "minimum": 0}}}}}
  }
}
