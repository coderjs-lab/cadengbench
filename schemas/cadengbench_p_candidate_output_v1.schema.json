{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_candidate_output_v1.schema.json",
  "title": "CADEngBench-P v1 Candidate Generator Output",
  "description": "Quarantined model-generator payload. Every claim remains a candidate; authority and promotion are assigned only outside this payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "item_id",
    "role_id",
    "claims",
    "abstentions",
    "output_status"
  ],
  "properties": {
    "schema_version": {
      "const": "cadengbench-p-candidate-output-v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "item_id": {
      "$ref": "#/$defs/itemId"
    },
    "role_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidateClaim"
      }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/abstention"
      }
    },
    "output_status": {
      "enum": [
        "complete",
        "partial",
        "abstained"
      ]
    }
  },
  "anyOf": [
    {
      "properties": {
        "claims": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "abstentions": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "itemId": {
      "type": "string",
      "pattern": "^p_(benchcad|fusion360|futurecad)_[0-9]{3,}$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "atomicValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "source_pointer": {
          "type": "string",
          "minLength": 1
        },
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "feature_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "face_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "edge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "parameter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "retrieval_record_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidateClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "field_path",
        "subject_ids",
        "predicate",
        "value",
        "unit",
        "claim_type",
        "confidence",
        "evidence_refs",
        "uncertainty_reason",
        "required_verification",
        "concise_rationale"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "subject_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/atomicValue"
        },
        "unit": {
          "$ref": "#/$defs/nullableString"
        },
        "claim_type": {
          "enum": [
            "source_fact",
            "geometry_fact",
            "visual_observation",
            "history_fact",
            "external_fact",
            "hypothesis"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "uncertainty_reason": {
          "$ref": "#/$defs/nullableString"
        },
        "required_verification": {
          "$ref": "#/$defs/nullableString"
        },
        "concise_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "reason",
        "evidence_refs",
        "concise_rationale"
      ],
      "properties": {
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "insufficient_evidence",
            "ambiguous",
            "not_visible",
            "not_applicable",
            "prohibited_inference"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "concise_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
