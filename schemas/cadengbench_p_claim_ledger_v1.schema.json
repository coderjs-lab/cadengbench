{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_claim_ledger_v1.schema.json",
  "title": "CADEngBench-P v1 deterministic claim ledger",
  "description": "Model-origin claims, deterministic verification states, critic records, and the frozen non-LLM promotion policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_version", "item_id", "claims", "critic_reviews", "promotion_policy", "summary"
  ],
  "properties": {
    "ledger_version": {"const": "cadengbench-p.claim-ledger.v1"},
    "item_id": {"$ref": "#/$defs/itemId"},
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "critic_reviews": {
      "type": "array",
      "items": {"$ref": "#/$defs/criticReview"}
    },
    "promotion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_agreement_promotes", "confidence_promotes", "deterministic_predicates"],
      "properties": {
        "model_agreement_promotes": {"const": false},
        "confidence_promotes": {"const": false},
        "deterministic_predicates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count", "promoted_count", "contradicted_count", "unresolved_count",
        "unsupported_promoted_count"
      ],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "promoted_count": {"type": "integer", "minimum": 0},
        "contradicted_count": {"type": "integer", "minimum": 0},
        "unresolved_count": {"type": "integer", "minimum": 0},
        "unsupported_promoted_count": {"const": 0}
      }
    }
  },
  "$defs": {
    "itemId": {
      "type": "string",
      "pattern": "^p_(benchcad|fusion360|futurecad)_[0-9]{3,}$"
    },
    "nullableString": {"type": ["string", "null"]},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "at", "rule_id"],
      "properties": {
        "state": {
          "enum": [
            "candidate", "evidence_linked", "machine_verified", "promoted", "contradicted",
            "unresolved", "rejected"
          ]
        },
        "at": {"type": "string", "format": "date-time"},
        "rule_id": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id", "field_path", "subject_ids", "predicate", "value", "unit", "claim_type",
        "model_claim_type", "origin_authority", "verification_authority", "confidence",
        "evidence_refs", "status", "uncertainty_reason", "required_verification",
        "concise_rationale", "generated_by_run_id", "promoted_by_rule_id", "event_log"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "field_path": {"type": "string", "minLength": 1},
        "subject_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "predicate": {"type": "string", "minLength": 1},
        "value": true,
        "unit": {"$ref": "#/$defs/nullableString"},
        "claim_type": {"const": "model_candidate"},
        "model_claim_type": {
          "enum": [
            "source_fact", "geometry_fact", "visual_observation", "history_fact",
            "external_fact", "hypothesis"
          ]
        },
        "origin_authority": {"enum": ["M4_multi_model_candidate", "M5_model_candidate"]},
        "verification_authority": {"enum": ["S0_source_explicit", "D1_deterministic_geometry", null]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidence_refs": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "status": {
          "enum": ["candidate", "evidence_linked", "promoted", "contradicted", "unresolved", "rejected"]
        },
        "uncertainty_reason": {"$ref": "#/$defs/nullableString"},
        "required_verification": {"$ref": "#/$defs/nullableString"},
        "concise_rationale": {"$ref": "#/$defs/nullableString"},
        "generated_by_run_id": {"type": "string", "minLength": 1},
        "promoted_by_rule_id": {"$ref": "#/$defs/nullableString"},
        "event_log": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/event"}
        }
      }
    },
    "criticReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "run_id", "findings", "abstentions", "output_status"],
      "properties": {
        "role_id": {"enum": ["grounding_critic", "adversarial_critic", "functional_edit_critic"]},
        "run_id": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {"type": "object"}},
        "abstentions": {"type": "array", "items": {"type": "object"}},
        "output_status": {
          "enum": ["complete", "partial", "abstained", "escalation_requested"]
        },
        "audit_id": {"type": "string", "minLength": 1},
        "audited_candidate_id": {"type": "string", "minLength": 1},
        "source_output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "json_pointer"],
          "properties": {
            "path": {"type": "string", "pattern": "^[^/].+"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "json_pointer": {"type": "string", "pattern": "^/"}
          }
        }
      }
    }
  }
}
