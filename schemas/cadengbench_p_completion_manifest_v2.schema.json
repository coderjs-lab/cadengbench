{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_completion_manifest_v2.schema.json",
  "title": "CADEngBench-P v2 completion and release manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "manifest_id", "dataset_version", "selection_manifest_sha256", "artifact_root", "expected_artifacts", "artifacts", "item_count", "stage_markers", "gate_results", "readiness_status", "completion_manifest_sha256", "immutable"],
  "properties": {
    "schema_version": {"const": "cadengbench-p.completion-manifest.v2"}, "record_type": {"const": "completion_manifest"}, "manifest_id": {"type": "string", "minLength": 1}, "dataset_version": {"type": "string", "minLength": 1}, "selection_manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "artifact_root": {"type": "string", "minLength": 1}, "expected_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}}, "item_count": {"type": "integer", "minimum": 1}, "stage_markers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["stage_id", "status", "marker_sha256"], "properties": {"stage_id": {"type": "string", "minLength": 1}, "status": {"enum": ["complete", "failed", "skipped"]}, "marker_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}}},
    "gate_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "status", "errors", "warnings"], "properties": {"gate_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "warning"]}, "errors": {"type": "integer", "minimum": 0}, "warnings": {"type": "integer", "minimum": 0}, "details": {"type": "string"}}}}, "readiness_status": {"enum": ["complete", "incomplete", "blocked"]}, "completion_manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "immutable": {"const": true}
  },
  "allOf": [{"if": {"properties": {"readiness_status": {"const": "complete"}}}, "then": {"properties": {"gate_results": {"items": {"properties": {"status": {"enum": ["pass", "warning"]}, "errors": {"const": 0}}}}}}}]
}
