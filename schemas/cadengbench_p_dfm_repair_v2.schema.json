{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_dfm_repair_v2.schema.json",
  "title": "CADEngBench-P v2 DFM repair contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "repair"],
  "properties": {
    "schema_version": {"const": "cadengbench-p.dfm-repair.v2"},
    "record_type": {"const": "dfm_repair"},
    "repair": {"$ref": "#/$defs/repair"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "repair": {
      "type": "object", "additionalProperties": false,
      "required": ["repair_id", "scenario_id", "intent_description_candidate", "violated_pre_edit_checks", "edit_target_binding", "parameter_binding", "expected_post_edit_checks", "preserved_feature_ids", "non_target_predicate_ids", "relation_ids", "parameter_space_ref", "negative_mutant_ids", "validation_contract", "authority", "status", "scorer_allowed", "source_intent_claimed"],
      "properties": {
        "repair_id": {"$ref": "#/$defs/nonEmpty"}, "scenario_id": {"$ref": "#/$defs/nonEmpty"}, "intent_description_candidate": {"$ref": "#/$defs/nonEmpty"},
        "violated_pre_edit_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "edit_target_binding": {"type": "object", "additionalProperties": false, "required": ["feature_id", "target_type", "source_pointer"], "properties": {"feature_id": {"$ref": "#/$defs/nonEmpty"}, "target_type": {"enum": ["feature_parameter", "geometry_measurement", "feature_presence"]}, "source_pointer": {"$ref": "#/$defs/nonEmpty"}}},
        "parameter_binding": {"type": "object", "additionalProperties": false, "required": ["parameter_id", "source_pointer", "authority"], "properties": {"parameter_id": {"$ref": "#/$defs/nonEmpty"}, "source_pointer": {"$ref": "#/$defs/nonEmpty"}, "authority": {"enum": ["source_explicit", "deterministic_geometry", "verified_replay", "needs_validation", "unavailable"]}}},
        "expected_post_edit_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "preserved_feature_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "non_target_predicate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "relation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}}, "parameter_space_ref": {"$ref": "#/$defs/nonEmpty"}, "negative_mutant_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "validation_contract": {"type": "object", "additionalProperties": false, "required": ["execute_after_edit", "pre_edit_failure_required", "post_edit_pass_required", "non_target_preservation_required", "negative_mutants_rejected", "llm_judge_used"], "properties": {"execute_after_edit": {"const": true}, "pre_edit_failure_required": {"const": true}, "post_edit_pass_required": {"const": true}, "non_target_preservation_required": {"const": true}, "negative_mutants_rejected": {"const": true}, "llm_judge_used": {"const": false}}},
        "validation_evidence_summary": {"type": "object", "additionalProperties": false, "required": ["native_replay_observed", "exact_pre_edit_failure_observed", "post_edit_check_reconstructed", "post_edit_check_passed", "non_target_preservation_observed", "negative_mutant_evidence_observed", "ready", "failure_reasons", "post_edit_check_reconstruction", "non_target_preservation", "negative_mutant_evidence"], "properties": {"repair_id": {"$ref": "#/$defs/nonEmpty"}, "pre_edit_checks_observed": {"type": "boolean"}, "post_edit_checks_observed": {"type": "boolean"}, "pre_edit_violation_confirmed": {"type": "boolean"}, "post_edit_requirements_satisfied": {"type": "boolean"}, "negative_mutants_rejected": {"type": "boolean"}, "negative_mutant_rejection": {"type": "object"}, "native_replay_observed": {"type": "boolean"}, "exact_pre_edit_failure_observed": {"type": "boolean"}, "post_edit_check_reconstructed": {"type": "boolean"}, "post_edit_check_passed": {"type": "boolean"}, "non_target_preservation_observed": {"type": "boolean"}, "negative_mutant_evidence_observed": {"type": "boolean"}, "ready": {"type": "boolean"}, "failure_reasons": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}}, "post_edit_check_reconstruction": {"type": "object"}, "non_target_preservation": {"type": "object"}, "negative_mutant_evidence": {"type": "object"}}},
        "authority": {"enum": ["source_explicit", "deterministic_geometry", "verified_replay", "generated_proxy", "llm_candidate", "needs_validation", "unavailable"]}, "status": {"enum": ["promoted", "candidate_only", "needs_validation", "rejected", "unavailable"]}, "scorer_allowed": {"type": "boolean"}, "source_intent_claimed": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "promoted"}}}, "then": {"properties": {"authority": {"enum": ["source_explicit", "deterministic_geometry", "verified_replay"]}, "scorer_allowed": {"const": true}}}},
        {"if": {"properties": {"authority": {"enum": ["generated_proxy", "llm_candidate", "needs_validation", "unavailable"]}}}, "then": {"properties": {"status": {"not": {"const": "promoted"}}, "scorer_allowed": {"const": false}}}},
        {"if": {"properties": {"status": {"enum": ["candidate_only", "needs_validation", "rejected", "unavailable"]}}}, "then": {"properties": {"scorer_allowed": {"const": false}}}}
      ]
    }
  }
}
