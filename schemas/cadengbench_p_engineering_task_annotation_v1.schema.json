{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cadengbench_p_engineering_task_annotation_v1.schema.json",
  "title": "CADEngBench-P compact engineering task annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "role_id",
    "output_status",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "cadengbench-p.engineering-task-annotation.v1"
    },
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "role_id": {
      "const": "engineering_task_author"
    },
    "output_status": {
      "const": "complete"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "materialFamily": {
      "enum": [
        "steel",
        "stainless_steel",
        "aluminum_alloy",
        "copper_alloy",
        "titanium_alloy",
        "cast_iron",
        "engineering_polymer",
        "elastomer",
        "unspecified"
      ]
    },
    "processFamily": {
      "enum": [
        "subtractive_machining",
        "additive_manufacturing",
        "injection_molding",
        "casting",
        "sheet_metal",
        "forming",
        "fabrication",
        "unspecified"
      ]
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_kind", "description"],
      "properties": {
        "interface_kind": {
          "enum": [
            "mounting",
            "mating",
            "locating",
            "fastening",
            "load_transfer",
            "fluid_or_airflow",
            "grip_or_handling",
            "protective_enclosure",
            "other"
          ]
        },
        "description": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "operatingCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "quantity_name",
        "comparator",
        "value",
        "unit"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/shortText"
        },
        "quantity_name": {
          "$ref": "#/$defs/label"
        },
        "comparator": {
          "enum": ["eq", "ge", "le", "range", "qualitative"]
        },
        "value": {
          "type": ["number", "null"]
        },
        "unit": {
          "enum": [
            "mm",
            "N",
            "N_mm",
            "MPa",
            "degC",
            "rpm",
            "count",
            "ratio",
            "dimensionless",
            "unspecified"
          ]
        }
      }
    },
    "effectProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_kind",
        "expected_direction",
        "comparator",
        "target_value",
        "unit",
        "measurement_method"
      ],
      "properties": {
        "metric_kind": {
          "enum": [
            "target_parameter_value",
            "clearance",
            "wall_thickness",
            "hole_diameter",
            "hole_depth_ratio",
            "volume",
            "surface_area",
            "geometric_envelope",
            "relation_satisfaction",
            "mass_property_proxy"
          ]
        },
        "expected_direction": {
          "enum": ["increase", "decrease", "meet_threshold", "maintain"]
        },
        "comparator": {
          "enum": ["eq", "ge", "le", "within_tolerance"]
        },
        "target_value": {
          "type": ["number", "null"]
        },
        "unit": {
          "enum": [
            "mm",
            "mm2",
            "mm3",
            "kg",
            "count",
            "ratio",
            "dimensionless",
            "unspecified"
          ]
        },
        "measurement_method": {
          "enum": [
            "native_parameter_replay",
            "brep_geometry",
            "closed_form",
            "smt_relation"
          ]
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_identity",
        "design",
        "function",
        "material_process",
        "functional_edit"
      ],
      "properties": {
        "part_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "category"],
          "properties": {
            "title": {
              "$ref": "#/$defs/label"
            },
            "category": {
              "$ref": "#/$defs/label"
            }
          }
        },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goal",
            "application_context",
            "global_form",
            "design_freedom"
          ],
          "properties": {
            "goal": {
              "$ref": "#/$defs/shortText"
            },
            "application_context": {
              "$ref": "#/$defs/shortText"
            },
            "global_form": {
              "$ref": "#/$defs/shortText"
            },
            "design_freedom": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/shortText"
              }
            }
          }
        },
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "functional_interpretation",
            "interfaces",
            "non_requirements"
          ],
          "properties": {
            "functional_interpretation": {
              "$ref": "#/$defs/shortText"
            },
            "interfaces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/interface"
              }
            },
            "non_requirements": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/shortText"
              }
            }
          }
        },
        "material_process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["material_family", "process_family", "basis"],
          "properties": {
            "material_family": {
              "$ref": "#/$defs/materialFamily"
            },
            "process_family": {
              "$ref": "#/$defs/processFamily"
            },
            "basis": {
              "enum": [
                "source_explicit",
                "benchmark_authored",
                "unspecified"
              ]
            }
          }
        },
        "functional_edit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operating_condition",
            "engineering_objective",
            "effect_proxy",
            "preservation_scope",
            "scope_limit"
          ],
          "properties": {
            "operating_condition": {
              "$ref": "#/$defs/operatingCondition"
            },
            "engineering_objective": {
              "$ref": "#/$defs/shortText"
            },
            "effect_proxy": {
              "$ref": "#/$defs/effectProxy"
            },
            "preservation_scope": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "enum": [
                  "valid_solid",
                  "solid_count",
                  "non_target_parameters",
                  "outer_envelope",
                  "feature_pattern",
                  "constraint_relations",
                  "interface_geometry"
                ]
              }
            },
            "scope_limit": {
              "$ref": "#/$defs/shortText"
            }
          }
        }
      }
    }
  }
}
