{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_fact_packet_v1.schema.json",
  "title": "CADEngBench-P v1 deterministic fact packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version", "item_id", "artifact_hashes", "units", "body_count", "bbox",
    "volume", "surface_area", "center_of_mass_geometry_only", "face_type_counts",
    "edge_type_counts", "topology_summary", "face_table", "edge_table",
    "raw_face_index_map", "hole_and_cavity_inventory", "manufacturing_feature_candidates",
    "operation_sequence", "operation_graph", "parameter_table", "constraint_relations",
    "feature_to_operation_map", "feature_to_face_edge_map", "source_text_facts",
    "source_history", "extractor_versions", "validation_results"
  ],
  "properties": {
    "packet_version": {"const": "cadengbench-p.fact-packet.v1"},
    "item_id": {"$ref": "#/$defs/itemId"},
    "artifact_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_step", "native_history"],
      "properties": {"canonical_step": {"$ref": "#/$defs/sha256"}, "native_history": {"$ref": "#/$defs/sha256"}}
    },
    "units": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_length", "canonical_angle"],
      "properties": {"canonical_length": {"const": "mm"}, "canonical_angle": {"const": "degree"}}
    },
    "body_count": {"type": "integer", "minimum": 1},
    "bbox": {"$ref": "#/$defs/bbox"},
    "volume": {"type": "number", "exclusiveMinimum": 0},
    "surface_area": {"type": "number", "exclusiveMinimum": 0},
    "center_of_mass_geometry_only": {"$ref": "#/$defs/vector3"},
    "face_type_counts": {"$ref": "#/$defs/countMap"},
    "edge_type_counts": {"$ref": "#/$defs/countMap"},
    "topology_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["solid_count", "shell_count", "face_count", "edge_count", "vertex_count", "is_valid"],
      "properties": {
        "solid_count": {"type": "integer", "minimum": 1}, "shell_count": {"type": "integer", "minimum": 1},
        "face_count": {"type": "integer", "minimum": 1}, "edge_count": {"type": "integer", "minimum": 1},
        "vertex_count": {"type": "integer", "minimum": 1}, "is_valid": {"type": "boolean"}
      }
    },
    "face_table": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "edge_table": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "raw_face_index_map": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^face_"}},
    "hole_and_cavity_inventory": {"$ref": "#/$defs/holeInventory"},
    "manufacturing_feature_candidates": {"type": "array", "items": {"type": "object"}},
    "operation_sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "operation_graph": {
      "type": "object", "additionalProperties": false, "required": ["nodes", "edges"],
      "properties": {"nodes": {"type": "array", "items": {"$ref": "#/$defs/operation"}}, "edges": {"type": "array", "items": {"type": "object"}}}
    },
    "parameter_table": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "constraint_relations": {"type": "array", "items": {"type": "object"}},
    "feature_to_operation_map": {"type": "array"},
    "feature_to_face_edge_map": {"type": "array"},
    "source_text_facts": {"type": "object"},
    "source_history": {"type": "object"},
    "extractor_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["geometry", "history", "entity_ids", "hole_inventory"],
      "properties": {"geometry": {"type": "string"}, "history": {"type": "string"}, "entity_ids": {"type": "string"}, "hole_inventory": {"type": "string"}}
    },
    "validation_results": {
      "type": "object", "additionalProperties": false,
      "required": ["step_readable", "solid_valid", "nonempty_geometry", "native_history_parsed"],
      "properties": {"step_readable": {"const": true}, "solid_valid": {"const": true}, "nonempty_geometry": {"const": true}, "native_history_parsed": {"const": true}}
    }
  },
  "$defs": {
    "itemId": {"type": "string", "pattern": "^p_(benchcad|fusion360|futurecad)_[0-9]{3,}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "bbox": {
      "type": "object", "additionalProperties": false,
      "required": ["xmin", "ymin", "zmin", "xmax", "ymax", "zmax", "xlen", "ylen", "zlen", "diagonal"],
      "properties": {
        "xmin": {"type": "number"}, "ymin": {"type": "number"}, "zmin": {"type": "number"},
        "xmax": {"type": "number"}, "ymax": {"type": "number"}, "zmax": {"type": "number"},
        "xlen": {"type": "number", "minimum": 0}, "ylen": {"type": "number", "minimum": 0},
        "zlen": {"type": "number", "minimum": 0}, "diagonal": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "countMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_occt_index", "signature", "signature_hash", "entity_id"],
      "properties": {
        "raw_occt_index": {"type": "integer", "minimum": 0}, "signature": {"type": "object"},
        "signature_hash": {"$ref": "#/$defs/sha256"}, "entity_id": {"type": "string", "pattern": "^(face|edge)_"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "operation_type", "source_pointer", "authority"],
      "properties": {
        "operation_id": {"type": "string"}, "operation_type": {"type": "string"},
        "name": {"type": ["string", "null"]}, "timeline_index": {"type": ["integer", "null"]},
        "sequence_index": {"type": ["integer", "null"]}, "source_pointer": {"type": "string"},
        "authority": {"const": "S0_source_explicit"}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["parameter_id", "semantic_name", "base_value", "unit", "source_pointer", "binding_kind", "editable", "authority"],
      "properties": {
        "parameter_id": {"type": "string"}, "semantic_name": {"type": ["string", "null"]},
        "base_value": {"type": ["number", "null"]}, "unit": {"type": "string"},
        "canonical_value": {"type": ["number", "null"]}, "canonical_unit": {"type": "string"},
        "source_pointer": {"type": "string"}, "feature_ref": {"type": "string"},
        "binding_kind": {"type": "string"}, "editable": {"type": "boolean"},
        "occ_replay_binding_id": {"type": "string", "minLength": 1},
        "occ_replay_qualified_candidate": {"const": true},
        "authority": {"const": "S0_source_explicit"}
      }
    },
    "holeInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "hole_count", "holes", "all_cylindrical_face_assessments", "limitations"],
      "properties": {
        "method": {"type": "string"}, "hole_count": {"type": "integer", "minimum": 0},
        "holes": {"type": "array", "items": {"type": "object"}},
        "all_cylindrical_face_assessments": {"type": "array", "items": {"type": "object"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
