{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_functional_edit_acceptance_v1.schema.json",
  "title": "CADEngBench-P deterministic functional-edit acceptance contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "contract_id",
    "item_id",
    "candidate_id",
    "edit_oracle_id",
    "source_key",
    "status",
    "scoring_scope",
    "parameter_contract",
    "core_checks",
    "candidate_declared_checks",
    "candidate_effect_contracts",
    "candidate_preservation_contracts",
    "hidden_reference_artifacts",
    "authority_boundary",
    "engineering_effect_scope",
    "llm_judge_used"
  ],
  "properties": {
    "schema_version": {"const": "cadengbench-p.functional-edit-acceptance.v1"},
    "record_type": {"const": "deterministic_functional_edit_acceptance"},
    "contract_id": {"type": "string", "minLength": 1},
    "item_id": {"type": "string", "pattern": "^p_(benchcad|fusion360)_[0-9]{3,}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "edit_oracle_id": {"type": "string", "minLength": 1},
    "source_key": {"enum": ["benchcad", "fusion360"]},
    "status": {"const": "verified_compiled"},
    "scoring_scope": {"const": "bounded_geometry_mediated_functional_edit"},
    "parameter_contract": {
      "type": "object",
      "required": [
        "parameter_key",
        "parameter_id",
        "feature_id",
        "source_pointer",
        "source_unit",
        "canonical_unit",
        "scale_to_canonical",
        "base_value",
        "target_value",
        "verified_probe_values",
        "domain",
        "measurement"
      ],
      "properties": {
        "parameter_key": {"type": "string", "minLength": 1},
        "parameter_id": {"type": "string", "minLength": 1},
        "feature_id": {"type": "string", "minLength": 1},
        "source_pointer": {"type": "string", "minLength": 1},
        "source_unit": {"type": "string", "minLength": 1},
        "canonical_unit": {"const": "mm"},
        "scale_to_canonical": {"type": "number", "exclusiveMinimum": 0},
        "base_value": {"type": "number"},
        "target_value": {"type": "number"},
        "verified_probe_values": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number"}
        },
        "domain": {"type": "object", "minProperties": 3},
        "measurement": {"type": "object"}
      }
    },
    "core_checks": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "method", "expected_value", "unit"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "expected_value": {},
          "unit": {"type": ["string", "null"]}
        }
      }
    },
    "candidate_declared_checks": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "candidate_effect_contracts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "candidate_preservation_contracts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "hidden_reference_artifacts": {
      "type": "object",
      "required": ["base_history", "base_step", "target_step", "target_history", "target_replay_report", "edit_binding_qualification"],
      "properties": {
        "base_history": {"$ref": "#/$defs/artifact"},
        "base_step": {"$ref": "#/$defs/artifact"},
        "target_step": {"$ref": "#/$defs/artifact"},
        "target_history": {"$ref": "#/$defs/artifact"},
        "target_replay_report": {"$ref": "#/$defs/artifact"},
        "edit_binding_qualification": {"$ref": "#/$defs/artifact"}
      }
    },
    "authority_boundary": {
      "type": "object",
      "required": ["edit_oracle_authority", "authority_scope", "generated_cadquery_proxy_used"]
    },
    "engineering_effect_scope": {"type": "string", "minLength": 1},
    "llm_judge_used": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"source_key": {"const": "fusion360"}}},
      "then": {
        "properties": {
          "parameter_contract": {
            "properties": {
              "source_unit": {"const": "cm"},
              "scale_to_canonical": {"const": 10},
              "source_pointer": {
                "pattern": "^/entities/.+/extent_one/distance/value$"
              },
              "measurement": {
                "type": "object",
                "required": [
                  "authority",
                  "method",
                  "brep_measurement",
                  "extent_multiplier"
                ],
                "properties": {
                  "authority": {"const": "D2_verified_replay_geometry"},
                  "method": {"const": "occt_brep_vertex_directional_extent_v1"},
                  "brep_measurement": {"type": "object", "minProperties": 3},
                  "extent_multiplier": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          },
          "authority_boundary": {
            "properties": {
              "authority_scope": {
                "const": "bounded_single_new_body_extrusion_patch_only"
              },
              "source_native_execution_used": {"const": false},
              "independent_occ_reconstruction_used": {"const": true},
              "generated_cadquery_proxy_used": {"const": false}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
