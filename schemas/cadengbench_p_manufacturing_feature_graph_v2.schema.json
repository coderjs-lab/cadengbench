{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_manufacturing_feature_graph_v2.schema.json",
  "title": "CADEngBench-P v2 manufacturing feature graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "graph"],
  "properties": {
    "schema_version": {"const": "cadengbench-p.manufacturing-feature-graph.v2"},
    "record_type": {"const": "manufacturing_feature_graph"},
    "graph": {"$ref": "#/$defs/graph"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "authority": {"enum": ["source_explicit", "deterministic_geometry", "verified_replay", "generated_proxy", "llm_candidate", "needs_validation", "unavailable"]},
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_id", "feature_type", "source_feature_ref", "face_edge_refs", "geometry_signature", "dimensions", "local_frame", "through_or_blind", "candidate_access_directions", "evidence_status", "authority"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/nonEmpty"},
        "feature_type": {"enum": ["hole", "bore", "pocket", "slot", "step", "boss", "planar_region", "fillet", "internal_radius", "chamfer", "thread_candidate", "groove", "undercut", "thin_wall", "web", "external_profile", "freeform_region"]},
        "source_feature_ref": {"anyOf": [{"$ref": "#/$defs/nonEmpty"}, {"type": "null"}]},
        "face_edge_refs": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "unresolved_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "geometry_signature": {"type": "object", "additionalProperties": false, "required": ["signature_type", "values"], "properties": {"signature_type": {"enum": ["native_id", "brep", "geometric", "unresolved"]}, "values": {"type": "object", "patternProperties": {"^[A-Za-z0-9_.:-]+$": {"type": ["string", "number", "boolean", "null", "array"]}}, "additionalProperties": false}}},
        "dimensions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "value", "unit"], "properties": {"name": {"$ref": "#/$defs/nonEmpty"}, "value": {"type": "number"}, "unit": {"$ref": "#/$defs/nonEmpty"}}}},
        "local_frame": {"type": "object", "additionalProperties": false, "required": ["origin", "axes"], "properties": {"origin": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "axes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}}}},
        "through_or_blind": {"enum": ["through", "blind", "not_applicable", "unknown"]},
        "candidate_access_directions": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
        "evidence_status": {"enum": ["promoted", "candidate_only", "needs_validation", "unavailable", "rejected"]},
        "authority": {"$ref": "#/$defs/authority"}
      },
      "allOf": [
        {"if": {"properties": {"evidence_status": {"const": "promoted"}}}, "then": {"properties": {"authority": {"enum": ["source_explicit", "deterministic_geometry", "verified_replay"]}}}},
        {"if": {"properties": {"authority": {"enum": ["generated_proxy", "llm_candidate", "needs_validation", "unavailable"]}}}, "then": {"properties": {"evidence_status": {"not": {"const": "promoted"}}}}}
      ]
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "source_feature_id", "target_feature_id", "relation_type", "evidence_status", "authority"],
      "properties": {"edge_id": {"$ref": "#/$defs/nonEmpty"}, "source_feature_id": {"$ref": "#/$defs/nonEmpty"}, "target_feature_id": {"$ref": "#/$defs/nonEmpty"}, "relation_type": {"enum": ["adjacency", "containment", "intersection", "symmetry", "shared_datum", "proximity", "access_blocking", "repair_dependency"]}, "evidence_status": {"enum": ["promoted", "candidate_only", "needs_validation", "unavailable", "rejected"]}, "authority": {"$ref": "#/$defs/authority"}},
      "allOf": [{"if": {"properties": {"evidence_status": {"const": "promoted"}}}, "then": {"properties": {"authority": {"enum": ["source_explicit", "deterministic_geometry", "verified_replay"]}}}}]
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["graph_id", "item_id", "scenario_id", "authority", "evidence_status", "nodes", "edges", "lineage_coverage", "evaluator_uses_llm_judge"],
      "properties": {
        "graph_id": {"$ref": "#/$defs/nonEmpty"}, "item_id": {"$ref": "#/$defs/nonEmpty"}, "scenario_id": {"anyOf": [{"$ref": "#/$defs/nonEmpty"}, {"type": "null"}]}, "authority": {"$ref": "#/$defs/authority"}, "evidence_status": {"enum": ["promoted", "candidate_only", "needs_validation", "unavailable", "rejected"]}, "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "lineage_coverage": {"type": "object", "additionalProperties": false, "required": ["source_feature_count", "bound_feature_count", "coverage_fraction", "fallback_status"], "properties": {"coverage_basis": {"enum": ["geometry_to_brep", "source_history_lineage"]}, "feature_count": {"type": "integer", "minimum": 0}, "source_feature_count": {"type": "integer", "minimum": 0}, "bound_feature_count": {"type": "integer", "minimum": 0}, "coverage_fraction": {"type": "number", "minimum": 0, "maximum": 1}, "fallback_status": {"enum": ["none", "deterministic_fallback", "unresolved"]}, "unresolved_refs": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}}, "source_history_lineage_status": {"enum": ["not_evaluated", "unavailable", "resolved"]}}},
        "evaluator_uses_llm_judge": {"const": false}
      },
      "allOf": [
        {"if": {"properties": {"evidence_status": {"const": "promoted"}}}, "then": {"properties": {"authority": {"enum": ["source_explicit", "deterministic_geometry", "verified_replay"]}}}},
        {"if": {"properties": {"authority": {"enum": ["generated_proxy", "llm_candidate", "needs_validation", "unavailable"]}}}, "then": {"properties": {"evidence_status": {"not": {"const": "promoted"}}}}}
      ]
    }
  }
}
