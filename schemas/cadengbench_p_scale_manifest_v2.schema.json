{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_scale_manifest_v2.schema.json",
  "title": "CADEngBench-P v2 bounded scale-up manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "manifest_id", "dataset_version", "selection_seed", "split_seed", "selected_items", "source_counts", "resource_estimates", "stages", "stage_order", "retry_policy", "environment_digest", "freeze_status"],
  "properties": {
    "schema_version": {"const": "cadengbench-p.scale-manifest.v2"}, "record_type": {"const": "scale_manifest"}, "manifest_id": {"type": "string", "minLength": 1}, "dataset_version": {"type": "string", "minLength": 1}, "selection_seed": {"type": "string", "minLength": 1}, "split_seed": {"type": "string", "minLength": 1},
    "selected_items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "source_id", "group_id", "split", "geometry_sha256", "dedup_sha256", "license_decision_sha256"], "properties": {"item_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "group_id": {"type": "string", "minLength": 1}, "split": {"enum": ["train", "dev", "validation", "test", "heldout"]}, "geometry_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "dedup_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "license_decision_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}}},
    "source_counts": {"type": "object", "patternProperties": {"^[A-Za-z0-9_.-]+$": {"type": "integer", "minimum": 0}}, "additionalProperties": false}, "resource_estimates": {"type": "object", "patternProperties": {"^[A-Za-z0-9_.-]+$": {"type": "number", "minimum": 0}}, "minProperties": 1, "additionalProperties": false},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["stage_id", "depends_on", "expected_artifacts"], "properties": {"stage_id": {"type": "string", "minLength": 1}, "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}}, "expected_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}, "stage_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retry_policy": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "retryable_statuses"], "properties": {"max_attempts": {"type": "integer", "minimum": 1}, "retryable_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}, "environment_digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "freeze_status": {"enum": ["draft", "validated", "frozen"]}, "freeze_reason": {"type": ["string", "null"]}, "selection_manifest_sha256": {"anyOf": [{"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, {"type": "null"}]}
  },
  "allOf": [{"if": {"properties": {"freeze_status": {"const": "frozen"}}}, "then": {"required": ["selection_manifest_sha256"], "properties": {"selection_manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}}}]
}
