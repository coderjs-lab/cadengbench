{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_zero_engineering_context_output_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "item_id", "role_id", "output_status", "payload", "abstentions"],
  "properties": {
    "schema_version": {"const": "cadengbench-p.zero-to-cad-role-output.v1"},
    "bundle_id": {"type": "string", "minLength": 1}, "item_id": {"type": "string", "minLength": 1},
    "role_id": {"const": "zero_engineering_context_analyst"},
    "output_status": {"enum": ["complete", "partial", "abstained"]},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["functional_interpretation", "interfaces", "material_process_scenario", "explicit_non_requirements", "limitations"],
      "properties": {
        "functional_interpretation": {"$ref": "#/$defs/prose"},
        "interfaces": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/interface"}},
        "material_process_scenario": {"$ref": "#/$defs/scenario"},
        "explicit_non_requirements": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/prose"}},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/prose"}}
      }
    },
    "abstentions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/prose"}}
  },
  "$defs": {
    "prose": {"type": "string", "minLength": 1, "maxLength": 700, "pattern": "^[^0-9]*$"},
    "factRef": {"type": "string", "pattern": "^FACT-[A-Z0-9_-]+$"},
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "purpose", "fact_refs", "status"],
      "properties": {
        "name": {"$ref": "#/$defs/prose"}, "purpose": {"$ref": "#/$defs/prose"},
        "fact_refs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/factRef"}},
        "status": {"enum": ["source_explicit", "benchmark_authored_scenario"]}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["material_family", "process_family", "rationale", "evidence_refs", "status"],
      "properties": {
        "material_family": {"enum": ["metal", "polymer", "ceramic", "composite", "timber", "unspecified"]},
        "process_family": {"enum": ["cnc_milling", "cnc_turning", "sheet_metal", "injection_molding", "casting", "additive_fdm", "additive_sla", "unspecified"]},
        "rationale": {"$ref": "#/$defs/prose"},
        "evidence_refs": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/factRef"}},
        "status": {"enum": ["source_explicit", "benchmark_authored_scenario", "unavailable"]}
      }
    }
  }
}
