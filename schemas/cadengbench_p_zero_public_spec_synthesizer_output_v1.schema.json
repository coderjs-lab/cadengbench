{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadengbench.org/schemas/cadengbench_p_zero_public_spec_synthesizer_output_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "item_id", "role_id", "output_status", "payload", "abstentions"],
  "properties": {
    "schema_version": {"const": "cadengbench-p.zero-to-cad-role-output.v1"},
    "bundle_id": {"type": "string", "minLength": 1}, "item_id": {"type": "string", "minLength": 1},
    "role_id": {"const": "zero_public_spec_synthesizer"},
    "output_status": {"enum": ["complete", "partial", "abstained"]},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "object_category", "design_goal", "application_context", "requirements", "allowed_design_freedom", "explicit_non_requirements", "preferred_profile"],
      "properties": {
        "title": {"$ref": "#/$defs/prose"}, "object_category": {"$ref": "#/$defs/prose"},
        "design_goal": {"$ref": "#/$defs/prose"}, "application_context": {"$ref": "#/$defs/prose"},
        "requirements": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/requirement"}},
        "allowed_design_freedom": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/prose"}},
        "explicit_non_requirements": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/prose"}},
        "preferred_profile": {"enum": ["zero_to_cad.text.v1", "zero_to_cad.text_iso.v1", "zero_to_cad.text_engineering_views.v1"]}
      }
    },
    "abstentions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/prose"}}
  },
  "$defs": {
    "prose": {"type": "string", "minLength": 1, "maxLength": 700, "pattern": "^[^0-9]*$"},
    "factRef": {"type": "string", "pattern": "^FACT-[A-Z0-9_-]+$"},
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "semantic_name", "model_visible_statement", "fact_refs", "criticality", "functional_role"],
      "properties": {
        "category": {"enum": ["geometry", "topology", "dimension", "relation", "parametricity", "function", "material", "process", "dfm", "standard"]},
        "semantic_name": {"$ref": "#/$defs/prose"}, "model_visible_statement": {"$ref": "#/$defs/prose"},
        "fact_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/factRef"}},
        "criticality": {"enum": ["required", "conditional"]},
        "functional_role": {"$ref": "#/$defs/prose"}
      }
    }
  }
}
